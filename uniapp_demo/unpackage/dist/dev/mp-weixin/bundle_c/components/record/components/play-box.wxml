<view class="play-box data-v-7dce998b"><view class="top-box data-v-7dce998b"><text class="title data-v-7dce998b">{{title}}</text><view class="schedule-box data-v-7dce998b"><view class="audio-number data-v-7dce998b">{{$root.m0}}</view><slider class="audio-slider data-v-7dce998b" step="1" activeColor="{{color}}" block-size="16" value="{{current}}" max="{{duration}}" data-event-opts="{{[['changing',[['e0',['$event']]]],['change',[['seekAudio',['$0'],['$event.detail.value']]]]]}}" bindchanging="__e" bindchange="__e"></slider><view class="audio-number data-v-7dce998b">{{$root.m1}}</view></view></view><view class="bottom-box data-v-7dce998b"><view data-event-opts="{{[['tap',[['backRecord',['$event']]]]]}}" class="btn-wrap data-v-7dce998b" bindtap="__e"><view class="reset-img data-v-7dce998b" data-text="重录"></view></view><view class="btn-wrap data-v-7dce998b"><block wx:if="{{status.playing}}"><view class="pause-img data-v-7dce998b" data-text="暂停" data-event-opts="{{[['tap',[['pauseAudio',['$event']]]]]}}" bindtap="__e"></view></block><block wx:else><view class="continue-img data-v-7dce998b" data-text="播放" data-event-opts="{{[['tap',[['playAudio',['$event']]]]]}}" bindtap="__e"></view></block></view></view></view>