<view class="record-box"><view class="time-wrap"><text class="{{['dot',status!==1?'':'dot-fade']}}"></text><text>{{''+(status==0?'准备录音':'正在录音')+"（"+minute+":"+second+'）'}}</text></view><view class="bottom-box"><block wx:if="{{status!==0}}"><view data-event-opts="{{[['tap',[['resetRecord',['$event']]]]]}}" class="btn-wrap" bindtap="__e"><view class="reset-img" data-text="重置"></view></view></block><view class="switch-wrap"><button data-event-opts="{{[['tap',[['switchChange',['$event']]]]]}}" class="{{[status===0?'':'start-wrap']}}" bindtap="__e"></button></view><block wx:if="{{status!==0}}"><view class="btn-wrap"><block wx:if="{{status===1}}"><view class="pause-img" data-text="暂停" data-event-opts="{{[['tap',[['pauseRecord',['$event']]]]]}}" bindtap="__e"></view></block><block wx:if="{{status===2}}"><view class="continue-img" data-text="继续" data-event-opts="{{[['tap',[['resumeRecord',['$event']]]]]}}" bindtap="__e"></view></block></view></block></view></view>