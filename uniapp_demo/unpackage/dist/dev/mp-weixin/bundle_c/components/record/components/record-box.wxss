}
.record-box .bottom-box .switch-wrap {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  padding: 0;
  background-color: #fff;
  box-sizing: border-box;
  border-radius: 50%;
  box-shadow: 0 0 10rpx 2rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
  margin-top: 15rpx;
}
.record-box .bottom-box .switch-wrap button {
  width: 100%;
  height: 100%;
}
.record-box .bottom-box .switch-wrap button::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 40rpx;
  height: 40rpx;
  background-color: #f30000;
  border-radius: 50%;
  -webkit-transform: translate(-50%, -50%);
          transform: translate(-50%, -50%);
}
.record-box .bottom-box .switch-wrap .start-wrap::after {
  border-radius: 8rpx;
}

