.record-box {
  width: 100%;
  padding: 30rpx;
  background-color: #fafafa;
  border: 1px solid #eee;
  border-radius: 20rpx;
  box-sizing: border-box;
}
.record-box .time-wrap {
  padding-left: 20rpx;
  font-size: 35rpx;
  color: #252326;
  display: flex;
  justify-content: center;
  align-items: center;
}
.record-box .time-wrap .dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background-color: #a1a1a1;
  margin: 0 15rpx;
}
.record-box .time-wrap .dot-fade {
  -webkit-animation: fade 1s infinite;
          animation: fade 1s infinite;
}
@-webkit-keyframes fade {
0% {
    opacity: 1;
}
50% {
    opacity: 0;
}
100% {
    opacity: 1;
}
}
@keyframes fade {
0% {
    opacity: 1;
}
50% {
    opacity: 0;
}
100% {
    opacity: 1;
}
}
.record-box .bottom-box {
  margin-top: 30rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
}
.record-box .bottom-box .btn-wrap .reset-img,
.record-box .bottom-box .btn-wrap .continue-img,
.record-box .bottom-box .btn-wrap .pause-img {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  padding-bottom: 45rpx;
  background-size: 100%;
  background-repeat: no-repeat;
}
.record-box .bottom-box .btn-wrap .reset-img::after,
.record-box .bottom-box .btn-wrap .continue-img::after,
.record-box .bottom-box .btn-wrap .pause-img::after {
  content: attr(data-text);
  position: absolute;
  bottom: 0;
  width: 100%;
  font-size: 22rpx;
  color: #333333;
  white-space: nowrap;
}
.record-box .bottom-box .btn-wrap .reset-img {
  background-image: url(data:image/png;base64,);
}
.record-box .bottom-box .btn-wrap .continue-img {
  background-image: url(data:image/png;base64,);
}
