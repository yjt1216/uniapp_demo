<view class="container"><u-navbar vue-id="fee68f06-1" auto-back="{{true}}" placeholder="{{true}}" title="音频播放" bind:__l="__l"></u-navbar><view><view class="title-1">其他音频测试：</view><view class="list"><audio-cc vue-id="fee68f06-2" title="{{musicList[1].title}}" src="{{musicList[1].src}}" alonePlay="{{alonePlay}}" bind:__l="__l"></audio-cc></view></view><view><view class="title-1">列表播放器：</view><view class="list"><audio-cc vue-id="fee68f06-3" title="{{music.title}}" src="{{music.src}}" alonePlay="{{alonePlay}}" autoplay="{{autoplay}}" firstCurrent="{{firstCurrent}}" playbackRate="{{playbackRate}}" data-event-opts="{{[['^ended',[['ended']]],['^currentChange',[['currentChange']]]]}}" bind:ended="__e" bind:currentChange="__e" bind:__l="__l"></audio-cc></view></view><view><view class="title-1">音频列表：</view><view class="list"><block wx:for="{{musicList}}" wx:for-item="music" wx:for-index="index" wx:key="index"><button data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" data-event-params="{{({index})}}" class="{{[(true)?'item':'',(index===selectedMusicIndex)?'active':'']}}" bindtap="__e">{{music.title}}</button></block></view></view><view><view class="title-1">功能列表：</view><view class="list"><button data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" bindtap="__e">上一首</button><button data-event-opts="{{[['tap',[['e2',['$event']]]]]}}" bindtap="__e">下一首</button><button data-event-opts="{{[['tap',[['e3',['$event']]]]]}}" bindtap="__e">{{"自动播放下一首:"+(autoplayNext?'启用':'禁止')}}</button><button data-event-opts="{{[['tap',[['e4',['$event']]]]]}}" bindtap="__e">{{"是否支持多音频同事播放:"+(!alonePlay?'启用':'禁止')}}</button></view></view><view><view class="title-1">倍速设置：</view><view class="list"><view class="item"><input data-event-opts="{{[['input',[['__set_model',['','playbackRate','$event',[]]]]]]}}" value="{{playbackRate}}" bindinput="__e"/></view></view></view><view><view class="title-1">首次快进（秒）：</view><view class="list"><view class="item"><input data-event-opts="{{[['input',[['__set_model',['','firstCurrent','$event',[]]]]]]}}" value="{{firstCurrent}}" bindinput="__e"/></view></view></view></view>