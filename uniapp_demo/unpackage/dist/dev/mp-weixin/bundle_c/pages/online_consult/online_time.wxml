<view class="w-time-picker"><u-navbar vue-id="79bb47c6-1" auto-back="{{true}}" placeholder="{{true}}" title="在线咨询时段" bind:__l="__l"></u-navbar><view class="user-content title">预约日期</view><view class="w-time-days"><scroll-view scroll-x="{{true}}"><view class="w-time-scroll"><block wx:for="{{dayList}}" wx:for-item="day" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['toggleDayIndex',['$0',index],[[['dayList','',index]]]]]]]}}" class="w-time-day" style="{{'color:'+(tabIndex==index?theme:'#333')+';'+('border-color:'+(tabIndex==index?theme:'#ddd')+';')}}" bindtap="__e"><view class="w-time-week">{{day.week}}</view><view class="w-time-date">{{day.month+"/"+day.day}}</view></view></block></view></scroll-view></view><view class="user-content title">预约时段</view><view class="w-time-body"><scroll-view class="w-time-list-scroll" scroll-y="{{true}}"><view class="w-time-list"><block wx:for="{{timeList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['toggleItem',['$0',index],[[['timeList','',index]]]]]]]}}" class="{{['w-time-item',(!item.disabled)?'w-time-item-active':'']}}" style="{{'color:'+(itemIndex==index?theme:'#333')+';'+('border-color:'+(itemIndex==index?theme:'#ddd')+';')}}" bindtap="__e">{{''+item.label+''}}</view></block></view></scroll-view></view><view class="w-time-footer"><view data-event-opts="{{[['tap',[['submit',['$event']]]]]}}" class="w-time-sure w-time-btn" style="{{'background-color:'+(theme)+';'}}" bindtap="__e">确定</view></view></view>