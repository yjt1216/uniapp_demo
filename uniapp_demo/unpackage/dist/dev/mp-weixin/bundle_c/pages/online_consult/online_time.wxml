<view class="w-time-picker"><u-navbar vue-id="79bb47c6-1" auto-back="{{true}}" placeholder="{{true}}" title="在线咨询时段" bind:__l="__l"></u-navbar><view class="user-content title">预约日期</view><view class="online-days"><scroll-view scroll-x="{{true}}"><view class="days-scroll"><block wx:for="{{$root.l0}}" wx:for-item="day" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['toggleDayIndex',['$0',index],[[['dayList','',index]]]]]]]}}" class="{{['day-item',(!day.m0)?'not-clickable':'']}}" style="{{'color:'+(dayIndex==index?theme:'#333')+';'+('border-color:'+(dayIndex==index?theme:'#ddd')+';')}}" bindtap="__e"><view class="day-week">{{day.$orig.week}}</view><view class="day-date">{{day.$orig.month+"/"+day.$orig.day}}</view></view></block></view></scroll-view></view><view class="user-content title">预约时段</view><view class="online-hour"><scroll-view class="hour-scroll" scroll-y="{{true}}"><view class="hour-list"><block wx:for="{{hourList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['toggleHourItem',['$0',index],[[['hourList','',index]]]]]]]}}" class="{{['hour-item',(!item.disabled)?'hour-item-active':'']}}" style="{{'color:'+(itemIndex==index?theme:'#333')+';'+('border-color:'+(itemIndex==index?theme:'#ddd')+';')}}" bindtap="__e">{{''+item.label+''}}</view></block></view></scroll-view></view><view class="user-content title">通话时长</view><view class="online-duration"><scroll-view class="hour-scroll" scroll-x="{{true}}"><view class="duration-list"><block wx:for="{{callDurationlist}}" wx:for-item="duration" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['toggleDurationIndex',['$0',index],[[['callDurationlist','',index]]]]]]]}}" class="duration-item" style="{{'color:'+(durationIndex==index?theme:'#333')+';'+('border-color:'+(durationIndex==index?theme:'#ddd')+';')}}" bindtap="__e">{{''+duration.name+''}}</view></block></view></scroll-view></view><view class="w-time-footer"><view data-event-opts="{{[['tap',[['submit',['$event']]]]]}}" class="w-time-sure w-time-btn" style="{{'background-color:'+(theme)+';'}}" bindtap="__e">确定</view></view></view>