.user-content {
  margin: 20rpx;
}
.title {
  color: #000000;
  font-weight: bold;
}
.select-box {
  display: flex;
  flex-direction: row;
  background-color: #ffffff;
  color: #FA800A;
  border-radius: 10rpx;
  height: 50rpx;
  width: 50rpx;
}
.meal-content-card {
  display: flex;
  flex-direction: row;
}
.select-box-time {
  width: 150rpx;
  margin-left: 10rpx;
  background-color: #FFFFFF;
  margin-bottom: 100rpx;
  text-align: center;
  font-size: 20rpx;
  padding: 5rpx;
}
.clear-btn {
  color: #FFFFFF;
  background-color: #FA800A;
  text-align: center;
  height: 50rpx;
  border-radius: 5rpx;
  padding-left: 10rpx;
  padding-right: 10rpx;
  line-height: 50rpx;
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: bold;
}
.w-time-days {
  overflow: hidden;
  padding: 16rpx;
  background-color: #fff;
}
.w-time-days .w-time-scroll {
  white-space: nowrap;
}
.w-time-days .w-time-day {
  display: inline-block;
  width: 80rpx;
  text-align: center;
  border: solid 1px #ddd;
  border-radius: 6rpx;
  padding: 10rpx 0;
  margin: 0 10rpx;
  color: #333;
}
.w-time-days .w-time-day .w-time-week {
  font-size: 22rpx;
  line-height: 1;
}
.w-time-days .w-time-day .w-time-date {
  font-size: 22rpx;
  line-height: 1;
  margin-top: 10rpx;
}
.w-time-days .w-time-day-active {
  color: #f00;
  border-color: #f00;
}
.w-time-body {
  flex: 1;
  overflow: hidden;
  background-color: #f5f5f5;
}
.w-time-body .w-time-list-scroll {
  height: 100%;
}
.w-time-body .w-time-list {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 10rpx;
}
.w-time-body .w-time-item {
  width: 120rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0 10rpx 20rpx;
  text-align: center;
  border: solid 1px #ddd;
  border-radius: 6rpx;
  font-size: 28rpx;
  transition: all 0.3s ease;
  color: #ddd !important;
}
.w-time-body .w-time-item-active {
  background-color: #fff;
  color: #000 !important;
}
.w-time-footer {
  height: 88rpx;
  display: flex;
  background-color: #fff;
}
.w-time-footer .w-time-btn {
  flex: 1;
  text-align: center;
  line-height: 88rpx;
  font-size: 30rpx;
}
.w-time-footer .w-time-sure {
  background-color: #f00;
  color: #fff;
}
.w-time-picker {
  width: 100%;
  height: 100%;
  z-index: 9999;
  background: rgba(66, 66, 66, 0.26);
  display: flex;
  flex-direction: column;
}

